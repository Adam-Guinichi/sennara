<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView style="@style/T.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/which_fish" />
            <TextView android:id="@+id/picked" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fish_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp">

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/other_layout" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/other_species">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/other_species" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:hint="@string/weight_g" app:startIconDrawable="@drawable/ic_scale">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/weight" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:hint="@string/length_cm" app:startIconDrawable="@drawable/ic_ruler">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/length" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/size_warning"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_warning"
                    android:drawablePadding="10dp"
                    android:padding="14dp"
                    android:textColor="@color/lv_unsafe"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_warning"
                    app:drawableTint="@color/lv_unsafe" />

                <TextView style="@style/T.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bait" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/baits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="shrimp" android:text="@string/bait_shrimp" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="worm" android:text="@string/bait_worm" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="sardine" android:text="@string/bait_sardine" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="bread" android:text="@string/bait_bread" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="squid" android:text="@string/bait_squid" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="lure" android:text="@string/bait_lure" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="jig" android:text="@string/bait_jig" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="live" android:text="@string/bait_live" />
                </com.google.android.material.chip.ChipGroup>

                <TextView style="@style/T.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/where" />
                <Spinner android:id="@+id/spot" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" />

                <com.google.android.material.card.MaterialCardView style="@style/CardFlat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/released"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/released_switch"
                        android:textAppearance="@style/T.BodyStrong" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/note">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/take_photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/Shape.Medium" />

                <Button android:id="@+id/btn_photo" style="@style/BtnTonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/take_photo" app:icon="@drawable/ic_camera" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">
        <Button android:id="@+id/submit" style="@style/Btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_catch" app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>

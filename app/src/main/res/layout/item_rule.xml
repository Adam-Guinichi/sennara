<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/rule_kind" style="@style/Pill" />
        <TextView android:id="@+id/rule_title" style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/rule_body" style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <Button android:id="@+id/rule_source" style="@style/BtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_source" app:icon="@drawable/ic_globe" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Greeting -->
            <LinearLayout
                android:id="@+id/tab_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/today"
                        style="@style/T.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/hello"
                        style="@style/T.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@string/profile"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Empty state (before the first sync) -->
            <LinearLayout
                android:id="@+id/empty_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_soft"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_sync"
                    app:tint="@color/accent_strong" />

                <TextView
                    style="@style/T.BodyStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/empty_home_title" />

                <TextView
                    style="@style/T.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_home_text"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- Hero: is it a good time to fish? -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="340dp">

                    <ImageView
                        android:id="@+id/hero_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/sea_900"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/scrim_full" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/hero_pill"
                            style="@style/Pill" />

                        <TextView
                            android:id="@+id/hero_title"
                            style="@style/T.Display"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/hero_spot"
                            style="@style/T.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawablePadding="4dp"
                            android:textColor="@color/on_photo_muted" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="48dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="88dp"
                                android:layout_height="88dp">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/hero_ring"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:max="100"
                                    app:indicatorColor="@color/accent"
                                    app:indicatorSize="88dp"
                                    app:trackColor="#40FFFFFF"
                                    app:trackCornerRadius="5dp"
                                    app:trackThickness="8dp" />

                                <TextView
                                    android:id="@+id/hero_score"
                                    style="@style/T.Display"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textColor="@color/white" />
                            </FrameLayout>

                            <LinearLayout
                                android:id="@+id/hero_reasons"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/hero_weather"
                            style="@style/T.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="@color/on_photo_muted" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Best window today with countdown -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/window_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/best_window" />

                            <TextView
                                android:id="@+id/window_score"
                                style="@style/Pill"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/window_time"
                            style="@style/T.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/window_label"
                            style="@style/T.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/window_clock"
                            style="@style/T.Display"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textDirection="ltr" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/window_remind"
                        style="@style/BtnIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/remind_me"
                        app:icon="@drawable/ic_bell" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next 24 hours -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/next_hours" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:scrollbars="none">

                        <com.sennara.app.ui.views.HourlyChartView
                            android:id="@+id/hours_chart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/hour_title"
                        style="@style/T.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />

                    <TextView
                        android:id="@+id/hour_detail"
                        style="@style/T.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qa_session"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_tile" android:importantForAccessibility="no" android:padding="10dp" android:src="@drawable/ic_timer" app:tint="@color/primary" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/qa_session" android:textColor="@color/text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qa_catch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_soft" android:importantForAccessibility="no" android:padding="10dp" android:src="@drawable/ic_add" app:tint="@color/accent_strong" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/qa_catch" android:textColor="@color/text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qa_safety"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_tile" android:importantForAccessibility="no" android:padding="10dp" android:src="@drawable/ic_lifebuoy" app:tint="@color/primary" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/qa_safety" android:textColor="@color/text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Fish biting near you -->
            <LinearLayout style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fish_near_title" />
                    <TextView android:id="@+id/fish_caption" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <Button android:id="@+id/fish_all" style="@style/BtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/see_all" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fish_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Spots for today -->
            <LinearLayout style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/spots_today_title" />
                    <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/spots_today_caption" />
                </LinearLayout>
                <Button android:id="@+id/spot_all" style="@style/BtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/see_all" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/spot_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Learn -->
            <LinearLayout style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learn_title" />
                    <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learn_caption" />
                </LinearLayout>
                <Button android:id="@+id/learn_all" style="@style/BtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/see_all" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/learn_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Shops -->
            <LinearLayout style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/T.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/shops_near_title" />
                <Button android:id="@+id/shop_all" style="@style/BtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/see_all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shops_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <!-- Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sync_text"
                    style="@style/T.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/sync_spin"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sync_btn"
                    style="@style/BtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_now"
                    app:icon="@drawable/ic_sync" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>

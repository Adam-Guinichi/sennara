<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/t_image" android:layout_width="match_parent" android:layout_height="168dp" android:background="@color/surface2" android:importantForAccessibility="no" android:scaleType="centerCrop" />
        <TextView android:id="@+id/t_level" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="16dp" android:layout_marginEnd="20dp" />
        <TextView android:id="@+id/t_title" style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="4dp" android:layout_marginEnd="20dp" android:layout_marginBottom="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

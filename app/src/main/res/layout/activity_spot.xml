<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Photo header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/sea_900"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/scrim_top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/scrim_bottom" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/name"
                        style="@style/T.Display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/sub"
                        style="@style/T.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/on_photo_muted" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Verdict -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/verdict_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView android:id="@+id/verdict_pill" style="@style/Pill" />

                                <TextView
                                    android:id="@+id/verdict_title"
                                    style="@style/T.Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/verdict_score"
                                style="@style/T.Display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/verdict_reasons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/verdict_best"
                            style="@style/T.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/verdict_source"
                            style="@style/T.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hour by hour -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_hours" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:scrollbars="none">

                            <com.sennara.app.ui.views.HourlyChartView
                                android:id="@+id/chart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/hour_head"
                            style="@style/T.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                <include android:id="@+id/t_wind" layout="@layout/item_tile" android:layout_width="match_parent" android:layout_height="wrap_content" />
                                <ImageView
                                    android:id="@+id/t_wind_arrow"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="12dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_navigation"
                                    app:tint="@color/primary" />
                            </FrameLayout>
                            <Space android:layout_width="8dp" android:layout_height="1dp" />
                            <include android:id="@+id/t_gust" layout="@layout/item_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                            <Space android:layout_width="8dp" android:layout_height="1dp" />
                            <include android:id="@+id/t_wave" layout="@layout/item_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <include android:id="@+id/t_sea" layout="@layout/item_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                            <Space android:layout_width="8dp" android:layout_height="1dp" />
                            <include android:id="@+id/t_rain" layout="@layout/item_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                            <Space android:layout_width="8dp" android:layout_height="1dp" />
                            <include android:id="@+id/t_pressure" layout="@layout/item_tile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3-day outlook -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/outlook" />

                <LinearLayout
                    android:id="@+id/outlook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Sun and moon -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/best_times_today" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/sky"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView android:id="@+id/sun_line" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                        <TextView android:id="@+id/moon_line" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/best_time" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Fish -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fish_here" />
                <TextView android:id="@+id/fish_caption" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-8dp" android:layout_marginBottom="8dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fish_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView style="@style/T.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/baits_now" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/baits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <!-- About -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_spot" />
                <TextView android:id="@+id/desc" style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/map_link" style="@style/BtnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/view_on_map" app:icon="@drawable/ic_map" />

                <!-- Community -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/community" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <RatingBar
                                    android:id="@+id/rating_stars"
                                    style="?android:attr/ratingBarStyleSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:isIndicator="true"
                                    android:numStars="5"
                                    android:progressTint="@color/accent" />

                                <TextView android:id="@+id/rating_summary" style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                                <TextView android:id="@+id/community_line" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                            </LinearLayout>

                            <Button android:id="@+id/rate" style="@style/BtnTonal" android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp" android:text="@string/rate" app:icon="@drawable/ic_star" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/reviews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Shops -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shops_near_spot" />

                <LinearLayout
                    android:id="@+id/shops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/scroll_bar" />


    <!-- Buttons floating on the photo -->
    <LinearLayout
        android:id="@+id/photo_actions"
        android:elevation="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <Button android:id="@+id/back" style="@style/BtnOnPhoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/back" app:icon="@drawable/ic_back" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/share" style="@style/BtnOnPhoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/share" app:icon="@drawable/ic_share" />
        <Button android:id="@+id/fav" style="@style/BtnOnPhoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/favorites" app:icon="@drawable/ic_heart" />
    </LinearLayout>

    <!-- Actions in the thumb zone -->
    <LinearLayout
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <Button android:id="@+id/directions" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/get_directions" app:icon="@drawable/ic_directions" />
        <Button android:id="@+id/session" style="@style/BtnTonal" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:contentDescription="@string/start_session_here" android:paddingStart="0dp" android:paddingEnd="0dp" app:icon="@drawable/ic_timer" app:iconPadding="0dp" app:iconGravity="textStart" />
        <Button android:id="@+id/remind" style="@style/BtnTonal" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:contentDescription="@string/remind_me" android:paddingStart="0dp" android:paddingEnd="0dp" app:icon="@drawable/ic_bell" app:iconPadding="0dp" app:iconGravity="textStart" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/tab_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_log" />
                        <TextView android:id="@+id/pending" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Button android:id="@+id/sync" style="@style/BtnIcon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/sync_now" app:icon="@drawable/ic_sync" />
                </LinearLayout>

                <!-- Stats -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/stat_catches" style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" />
                                <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stat_catches" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/stat_kg" style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" />
                                <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stat_kg" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/stat_species" style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" />
                                <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stat_species" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/stat_best" style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:drawablePadding="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Session shortcut -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/session_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/primary">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_soft" android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_timer" app:tint="@color/accent_strong" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/session_title" style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                            <TextView android:id="@+id/session_text" style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron" app:tint="@color/on_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Month chart -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:text="@string/per_month" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">

                    <com.sennara.app.ui.views.MonthChartView
                        android:id="@+id/month_chart"
                        android:layout_width="match_parent"
                        android:layout_height="168dp"
                        android:padding="16dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Badges -->
                <LinearLayout style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/T.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/badges" />
                    <TextView android:id="@+id/badges_count" style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <!-- Catch list -->
                <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:text="@string/my_catches" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    app:checkedChip="@id/sort_new"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/sort_new" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="new" android:text="@string/sort_newest" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="heavy" android:text="@string/sort_heaviest" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="species" android:text="@string/sort_species" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_circle_soft" android:importantForAccessibility="no" android:padding="18dp" android:src="@drawable/ic_hook" app:tint="@color/accent_strong" />
                    <TextView style="@style/T.BodyStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/empty_catches_title" />
                    <TextView style="@style/T.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/empty_catches_text" android:textAlignment="center" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="@string/add_catch"
            android:textAppearance="@style/T.Button"
            android:textColor="@color/on_accent"
            app:backgroundTint="@color/accent"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/on_accent" />
    </FrameLayout>

    <include layout="@layout/bottom_nav" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ob_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/ob_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/surface2"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/ob_hello"
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- Step 1: level -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ob_level_title" />
                <TextView style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="@string/ob_level_text" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lvl_beginner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:checkable="true"
                    app:checkedIconTint="@color/accent"
                    app:strokeColor="@color/pick_stroke"
                    app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_tile" android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_school" app:tint="@color/primary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/level_beginner" />
                            <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ob_beginner_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lvl_intermediate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:checkable="true"
                    app:checkedIconTint="@color/accent"
                    app:strokeColor="@color/pick_stroke"
                    app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_tile" android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_hook" app:tint="@color/primary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/level_intermediate" />
                            <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ob_intermediate_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lvl_expert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    app:checkedIconTint="@color/accent"
                    app:strokeColor="@color/pick_stroke"
                    app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_tile" android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_trophy" app:tint="@color/primary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/T.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/level_expert" />
                            <TextView style="@style/T.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ob_expert_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: fishing styles -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ob_style_title" />
                <TextView style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="@string/ob_style_text" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ob_styles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="shore" android:text="@string/type_shore" app:chipIcon="@drawable/ic_waves" app:chipIconVisible="true" app:chipMinHeight="52dp" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="rock" android:text="@string/type_rock" app:chipIcon="@drawable/ic_place" app:chipIconVisible="true" app:chipMinHeight="52dp" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="port" android:text="@string/type_port" app:chipIcon="@drawable/ic_sailing" app:chipIconVisible="true" app:chipMinHeight="52dp" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="lagoon" android:text="@string/type_lagoon" app:chipIcon="@drawable/ic_water" app:chipIconVisible="true" app:chipMinHeight="52dp" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="boat" android:text="@string/hab_boat" app:chipIcon="@drawable/ic_sailing" app:chipIconVisible="true" app:chipMinHeight="52dp" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </ScrollView>

        <!-- Step 3: permissions -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ob_perm_title" />
                <TextView style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="@string/ob_perm_text" />
                <Button
                    android:id="@+id/ob_location"
                    style="@style/BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_my_location" />
                <Button
                    android:id="@+id/ob_notifications"
                    style="@style/BtnTonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:icon="@drawable/ic_bell" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <LinearLayout
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp">

        <Button
            android:id="@+id/ob_skip"
            style="@style/BtnText"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/skip" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Button
            android:id="@+id/ob_next"
            style="@style/Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp" />
    </LinearLayout>
</LinearLayout>

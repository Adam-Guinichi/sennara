<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/primary">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/st_users" style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/users" android:textColor="@color/on_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/st_spots" style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_spots" android:textColor="@color/on_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/st_shops" style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_shops" android:textColor="@color/on_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/st_catches" style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_catches" android:textColor="@color/on_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/st_reviews" style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" />
                <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reviews" android:textColor="@color/on_primary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="20dp" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/tab_spots"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/tab_spots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="spots" android:text="@string/pending_spots" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="shops" android:text="@string/pending_shops" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="reviews" android:text="@string/reviews" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:tag="users" android:text="@string/users" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView android:id="@+id/empty" style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="32dp" android:text="@string/empty_admin" android:textAlignment="center" />
</LinearLayout>

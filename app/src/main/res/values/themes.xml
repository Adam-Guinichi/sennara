<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sennara" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/text2</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface2</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/lv_unsafe</item>
        <item name="colorControlNormal">@color/text2</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:fontFamily">@font/plex</item>
        <item name="fontFamily">@font/plex</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Large</item>
        <item name="materialCardViewStyle">@style/Card</item>
        <item name="chipStyle">@style/ChipFilter</item>
        <item name="textAppearanceLabelLarge">@style/T.Button</item>
        <item name="textAppearanceBodyLarge">@style/T.Body</item>
        <item name="textAppearanceBodyMedium">@style/T.Body</item>
        <item name="textAppearanceTitleMedium">@style/T.BodyStrong</item>
        <item name="textAppearanceTitleLarge">@style/T.Title</item>
        <item name="textAppearanceHeadlineSmall">@style/T.Title</item>
        <item name="bottomNavigationStyle">@style/BottomNav</item>
        <item name="materialAlertDialogTheme">@style/Dialog</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/plex</item>
        <item name="fontFamily">@font/plex</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Large</item>
    </style>

    <style name="Shape.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Shape.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Shape.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Type scale: 4 sizes (32 / 20 / 15 / 13) and 2 weights (regular / semibold). -->
    <style name="T" parent="">
        <item name="android:fontFamily">@font/plex</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="T.Display">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="T.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="T.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
        <item name="android:textColor">@color/text2</item>
    </style>
    <style name="T.BodyStrong">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="T.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text3</item>
    </style>
    <style name="T.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text2</item>
    </style>
    <style name="T.Button">
        <item name="android:fontFamily">@font/plex</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="T.Section" parent="T.Title" />

    <!-- Components -->
    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/shadow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/shadow</item>
    </style>
    <style name="CardFlat" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface2</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Btn" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/T.Button</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Btn.Dark">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
    </style>
    <style name="BtnTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/T.Button</item>
    </style>
    <style name="BtnOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/text</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/T.Button</item>
    </style>
    <style name="BtnText" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/T.Button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>
    <style name="BtnIcon" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="iconTint">@color/primary</item>
        <item name="iconSize">22dp</item>
    </style>
    <!-- Round white buttons floating on photos (back, share, favourite). -->
    <style name="BtnOnPhoto" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">#E6FFFFFF</item>
        <item name="iconTint">#0D2230</item>
        <item name="iconSize">22dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">@color/text3</item>
        <item name="endIconMode">clear_text</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="ChipFilter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="checkedIconTint">@color/white</item>
        <item name="chipIconTint">@color/chip_text</item>
        <item name="android:textAppearance">@style/T.Label</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <style name="Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/plex</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNav.Indicator</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemTextAppearanceActive">@style/T.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/T.NavLabel</item>
        <item name="android:elevation">8dp</item>
    </style>
    <style name="BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_soft</item>
    </style>
    <style name="T.NavLabel" parent="">
        <item name="android:fontFamily">@font/plex</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
